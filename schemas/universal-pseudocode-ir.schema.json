{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"UniversalPseudocodeIR",
 "type":"object",
 "required":["version","source_language","units"],
 "properties":{
  "version":{"const":"0.1"},
  "source_language":{"type":"string"},
  "source_version":{"type":["string","null"]},
  "units":{"type":"array","items":{"type":"object","required":["kind","pseudocode"],"properties":{
   "kind":{"type":"string"},
   "name":{"type":["string","null"]},
   "pseudocode":{"type":"string"},
   "semantic_annotations":{"type":"array","items":{"type":"object","required":["feature","status"],"properties":{
    "feature":{"type":"string"},
    "status":{"enum":["represented","annotated","ambiguous","unsupported"]},
    "detail":{"type":["string","null"]}
   },"additionalProperties":false}}
  },"additionalProperties":false}},
  "capabilities":{"type":"array","items":{"type":"string"}},
  "unresolved":{"type":"array","items":{"type":"string"}}
 },
 "additionalProperties":false
}