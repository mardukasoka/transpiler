{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranspileRequest",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "target",
    "mode",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "location"
      ],
      "properties": {
        "kind": {
          "enum": [
            "snippet",
            "file",
            "project"
          ]
        },
        "location": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "runtime"
      ],
      "properties": {
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": "string"
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "inspect",
        "plan",
        "transpile",
        "validate",
        "report"
      ]
    },
    "adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "network": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
